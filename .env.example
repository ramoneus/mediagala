# Optional settings for MediaGala. Copy this file to ".env" (same folder) and fill in what you want.
# The .env file stays on your computer: it's in .gitignore, so it never goes to GitHub.

# Free TMDB key for the movie search (better posters, genres and descriptions).
# Get one at https://www.themoviedb.org/settings/api ("API Key" or "API Read Access Token" both work).
# Left empty, movies are looked up on Wikipedia instead.
TMDB_API_KEY=
